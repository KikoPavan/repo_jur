# Ambiente virtual
.venv/

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Variáveis e credenciais
.env
.env.*
!.env.example

# Diretórios operacionais
output/*
logs/*
var/tmp/*
var/object-storage/*
var/retrieval/*
var/producer/*
var/routing/*
var/ingress/*
var/conformance/*
var/intake/*
!output/.gitkeep
!logs/.gitkeep
!var/tmp/.gitkeep
!var/object-storage/.gitkeep
!var/producer/.gitkeep
!var/routing/.gitkeep
!var/ingress/.gitkeep
!var/conformance/.gitkeep
!var/intake/.gitkeep

# Gerenciamento de input (Ignora conteúdo, preserva estrutura)
input/*
!input/.gitkeep
!input/legislacao/
!input/jurisprudencia/
!input/temas/
!input/precedentes/
input/legislacao/*
input/jurisprudencia/*
input/temas/*
input/precedentes/*
!input/legislacao/.gitkeep
!input/jurisprudencia/.gitkeep
!input/temas/.gitkeep
!input/precedentes/.gitkeep

# Sistema e editor
.DS_Store
.vscode/
.idea/

# Dependências Node locais dos agentes
**/node_modules/

# Configurações locais do Claude
.claude/settings.local.json

# Gemini CLI não utilizado neste projeto
.gemini/
